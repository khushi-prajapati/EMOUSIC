# Core Django settings
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_SITE_URL=http://localhost:5173
DJANGO_LOG_LEVEL=INFO

# Local database (Docker Compose overrides these values with PostgreSQL)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Authentication
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# External music metadata providers
YOUTUBE_API_KEY=replace-with-your-youtube-data-api-v3-key
SPOTIFY_CLIENT_ID=replace-with-your-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-with-your-spotify-client-secret
SPOTIFY_MARKET=US

# Celery and caching (optional for basic local development)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# API throttling
DRF_ANON_THROTTLE_RATE=60/min
DRF_USER_THROTTLE_RATE=600/min

# Emotion detection limits and local cache locations
AI_EMOTION_USE_MTCNN=False
AI_EMOTION_MAX_IMAGE_BYTES=2500000
AI_EMOTION_MAX_IMAGE_DIMENSION=960
AI_EMOTION_MPLCONFIG_DIR=/tmp/emusic-matplotlib
AI_EMOTION_FONT_CACHE_DIR=/tmp/emusic-cache

# Production security (enable behind HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CSRF_COOKIE_HTTPONLY=False
X_FRAME_OPTIONS=DENY
